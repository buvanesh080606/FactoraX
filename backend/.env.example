# FactoraX Backend Environment Template
# Copy this file to backend/.env and fill in your real credentials (never commit backend/.env)
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Neon Serverless PostgreSQL (Production / Cloud 24/7):
DATABASE_URL=postgresql://<neon_user>:<neon_password>@<neon-pooler-host>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Local PostgreSQL fallback:
# DATABASE_URL=postgresql://smartfactory:smartfactory123@127.0.0.1:5433/smartfactory

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
